{
  "name": "led-ratio-tool-desktop",
  "version": "1.3.0",
  "private": true,
  "license": "MIT",
  "description": "LED Ratio Tool —— 屏幕尺寸与视频画布比例换算工具（Windows 桌面版）",
  "main": "main/main.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "preflight": "node build/preflight.cjs",
    "sync": "node build/sync-assets.mjs",
    "sync:check": "node build/sync-assets.mjs --check-only",
    "core:accept": "node build/sync-assets.mjs --accept-core",
    "audit:security": "node test/security-audit.cjs",
    "test:pitch": "node --test test/led-pitch.test.mjs",
    "test:settings-compat": "node --test test/settings-compat.test.mjs",
    "evidence:p4a": "node test/p4a-evidence.cjs",
    "evidence:p4b": "node test/p4b-evidence.cjs",
    "test:smoke": "node test/smoke-launch.mjs --runs=10",
    "test:desktop": "node test/desktop-suite.mjs",
    "test:visual": "node test/visual-regression.mjs",
    "test:differential": "node test/differential-200.mjs",
    "test:golden": "node test/golden-vectors.mjs",
    "test:golden:selftest": "node test/golden-negative-selftest.mjs",
    "test:dpi": "node test/dpi-acceptance.mjs",
    "test:p7-artifacts": "node test/p7-artifacts.mjs",
    "test:p7-acceptance": "node test/p7-acceptance.mjs",
    "test:p7-dpi": "node test/p7-dpi.mjs",
    "test:pc": "node test/pc-verify.mjs",
    "verify:icons": "node build/verify-icons.mjs",
    "test:fuses": "node test/fuses-verify.mjs",
    "dev": "npm run preflight && node build/sync-assets.mjs && electron .",
    "build:win": "npm run preflight && npm run verify:icons && node build/sync-assets.mjs && electron-builder --win --x64 --config build/electron-builder.yml"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "playwright-core": "1.56.1"
  },
  "author": {
    "name": "LED Ratio Tool Authors"
  }
}
