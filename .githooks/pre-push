#!/usr/bin/env bash
#
# LED-ratio-Tool · Git pre-push 钩子
# =============================================================================
# 真实实现 Git 原生 pre-push 协议：Git 通过**标准输入**提供待推送的 ref 列表，
# 每行格式为：
#
#     <local ref> <local sha1> <remote ref> <remote sha1>
#
# ⚠️ 常见误解：Git **不会**自动提供 GIT_PUSH_REF 环境变量。任何依赖该环境变量
#    的检查在真实 git push 场景下都读不到值 —— 必须解析标准输入。
#
# -----------------------------------------------------------------------------
# 钩子会拦截的推送（对应 GITHUB-RULES.md 的 R-4 / R-6）：
#   · 目标分支为 main / master                    → 拒绝（禁止直推）
#   · 目标分支不符合约定工作分支命名              → 拒绝（见 WORK_PREFIXES）
#   · 删除受保护分支（main / master / feature/*） → 拒绝
#   · 删除受保护标签（pre-desktop）               → 拒绝
#
# 允许的推送（2026-11-04 起，约定式分支命名）：
#   feature/*  fix/*  chore/*  docs/*  test/*  refactor/*  perf/*
#   以及历史开发主分支 feature/desktop-windows（被 feature/* 覆盖，显式保留以自证）。
#
# -----------------------------------------------------------------------------
# 🔴 修复记录（2026-11-04）：
#   v1 的 PROTECTED_BRANCHES **从未声明**（只有 PROTECTED_TAGS），删除分支检查
#   迭代的是空数组 —— 结果「删除 main」只产生 ⚠️ 警告而不拦截，与文档声明相反。
#   本版显式声明受保护清单，并让删除检查同时支持精确名与前缀（feature/*）。
#   新增真实 stdin 自测：npm run test:hooks（test/githooks-selftest.mjs）。
#
# -----------------------------------------------------------------------------
# 它**不能**做的事（务必知悉）：
#   · 不能阻止他人推送（钩子只在本机本地执行）
#   · 不能阻止 GitHub 上的合并（那由 GitHub Rulesets / 分支保护承担）
#   · 不能识别"项目负责人是否已授权"—— 授权是人的判断
#
# -----------------------------------------------------------------------------
# 安装方式（一次性）：
#     git config core.hooksPath .githooks
# 验证安装：
#     git config core.hooksPath            # 应输出 .githooks
#
# 手动测试（不实际推送）：
#     npm run test:hooks                   # 真实 stdin 全用例自测
#     bash .githooks/pre-push              # 空输入（提示后放行）
#
# 退出码：0 = 允许推送；非 0 = 拒绝推送
# =============================================================================

set -uo pipefail

DEV_BRANCH="feature/desktop-windows"

# 🔴 受保护分支（**禁止删除**）—— 显式声明，修复 v1 未声明的保护漏洞。
#    main / master 是正式分支；feature/* 承载 PR 历史与评审记录。
PROTECTED_BRANCHES=("main" "master" "$DEV_BRANCH")
# 受保护分支前缀：删除任意 feature/* 分支同样拦截。
PROTECTED_BRANCH_PREFIXES=("feature/")

# 受保护标签（禁止删除）：pre-desktop 是回滚锚点
PROTECTED_TAGS=("pre-desktop")

# 允许推送的工作分支（约定式命名，前缀匹配）；main/master 已由 R-4 单独拒绝。
WORK_PREFIXES=("feature/" "fix/" "chore/" "docs/" "test/" "refactor/" "perf/")

RED=$'\033[31m'
GREEN=$'\033[32m'
YELLOW=$'\033[33m'
DIM=$'\033[2m'
RESET=$'\033[0m'

if [ -t 1 ]; then
  COLOR_ERR="$RED"; COLOR_OK="$GREEN"; COLOR_WARN="$YELLOW"; COLOR_DIM="$DIM"; COLOR_RESET="$RESET"
else
  COLOR_ERR=""; COLOR_OK=""; COLOR_WARN=""; COLOR_DIM=""; COLOR_RESET=""
fi

# 读取 Git 通过标准输入提供的待推送 ref 列表
PUSH_LINES=""
if [ ! -t 0 ]; then
  PUSH_LINES="$(cat)"
fi

if [ -z "$PUSH_LINES" ]; then
  echo "${COLOR_WARN}[pre-push]${COLOR_RESET} 标准输入为空 —— 未获取到待推送 ref 列表。"
  echo "${COLOR_DIM}  手动运行时属于正常现象（Git 才会传入真实列表）。${COLOR_RESET}"
  echo "${COLOR_DIM}  若通过 git push 触发却为空，说明该 Git 版本行为异常。${COLOR_RESET}"
  exit 0
fi

REMOTE_NAME="$(git config --get remote.pushDefault 2>/dev/null || echo origin)"

echo "${COLOR_DIM}[pre-push] 远端 = $REMOTE_NAME${COLOR_RESET}"
echo "${COLOR_DIM}[pre-push] 待推送 ref：${COLOR_RESET}"

BLOCKED=0
PUSHED=0

# ---- 匹配辅助 --------------------------------------------------------------
# 是否命中受保护分支（精确名或受保护前缀）
is_protected_branch() {
  local b="$1" p
  for p in "${PROTECTED_BRANCHES[@]}"; do
    [ "$b" = "$p" ] && return 0
  done
  for p in "${PROTECTED_BRANCH_PREFIXES[@]}"; do
    case "$b" in "$p"*) return 0 ;; esac
  done
  return 1
}

# 是否为允许推送的工作分支（约定前缀）
is_allowed_work_branch() {
  local b="$1" p
  [ "$b" = "$DEV_BRANCH" ] && return 0
  for p in "${WORK_PREFIXES[@]}"; do
    case "$b" in "$p"*) return 0 ;; esac
  done
  return 1
}

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [ -z "${REMOTE_REF:-}" ] && continue
  PUSHED=$((PUSHED + 1))

  case "$REMOTE_REF" in
    refs/heads/*)
      TARGET_BRANCH="${REMOTE_REF#refs/heads/}"
      echo "  分支  $LOCAL_REF -> $REMOTE_REF"

      # 删除操作：local sha 为全零
      if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
        if is_protected_branch "$TARGET_BRANCH"; then
          echo "${COLOR_ERR}    ⛔ 拒绝删除受保护分支 '$TARGET_BRANCH'${COLOR_RESET}"
          echo "${COLOR_ERR}       受保护清单：${PROTECTED_BRANCHES[*]}（及前缀 ${PROTECTED_BRANCH_PREFIXES[*]}*）${COLOR_RESET}"
          BLOCKED=1
        else
          echo "${COLOR_WARN}    ⚠️  允许删除非受保护分支 '$TARGET_BRANCH'${COLOR_RESET}"
        fi
        continue
      fi

      # R-4：禁止直接推送 main / master
      if [ "$TARGET_BRANCH" = "main" ] || [ "$TARGET_BRANCH" = "master" ]; then
        echo "${COLOR_ERR}    ⛔ 拒绝推送到 '$TARGET_BRANCH'${COLOR_RESET}"
        echo "${COLOR_ERR}       规则 R-4：禁止直接向 main 推送提交。请推送到约定工作分支，${COLOR_RESET}"
        echo "${COLOR_ERR}       再由项目负责人审查后走 PR 合并。${COLOR_RESET}"
        BLOCKED=1
        continue
      fi

      # 目标分支须符合约定工作分支命名
      if ! is_allowed_work_branch "$TARGET_BRANCH"; then
        echo "${COLOR_ERR}    ⛔ 目标分支 '$TARGET_BRANCH' 不符合约定工作分支命名${COLOR_RESET}"
        echo "${COLOR_ERR}       允许前缀：${WORK_PREFIXES[*]}${COLOR_RESET}"
        BLOCKED=1
        continue
      fi

      echo "${COLOR_OK}    ✅ 允许${COLOR_RESET}"
      ;;

    refs/tags/*)
      TARGET_TAG="${REMOTE_REF#refs/tags/}"
      echo "  标签  $LOCAL_REF -> $REMOTE_REF"

      # 删除标签
      if [ "$LOCAL_SHA" = "0000000000000000000000000000000000000000" ]; then
        IS_PROTECTED=0
        for PROTECTED in "${PROTECTED_TAGS[@]:-}"; do
          if [ "$TARGET_TAG" = "$PROTECTED" ]; then
            IS_PROTECTED=1
          fi
        done
        if [ "$IS_PROTECTED" -eq 1 ]; then
          echo "${COLOR_ERR}    ⛔ 拒绝删除受保护标签 '$TARGET_TAG'${COLOR_RESET}"
          echo "${COLOR_ERR}       pre-desktop 是回滚锚点，删除它等同于销毁回滚能力。${COLOR_RESET}"
          BLOCKED=1
        else
          echo "${COLOR_WARN}    ⚠️  允许删除非受保护标签 '$TARGET_TAG'${COLOR_RESET}"
        fi
        continue
      fi

      echo "${COLOR_OK}    ✅ 允许${COLOR_RESET}"
      ;;

    *)
      echo "  其它  $LOCAL_REF -> $REMOTE_REF"
      ;;
  esac
done <<< "$PUSH_LINES"

echo ""

if [ "$BLOCKED" -ne 0 ]; then
  echo "${COLOR_ERR}[pre-push] 推送被拦截。${COLOR_RESET}"
  echo "${COLOR_DIM}  如确需推送到受保护分支，请先取得项目负责人授权，并改用 PR 流程。${COLOR_RESET}"
  echo "${COLOR_DIM}  注意：本钩子只在本机生效；远端 main 的真正保护由 GitHub Rulesets 承担。${COLOR_RESET}"
  exit 1
fi

echo "${COLOR_OK}[pre-push] 检查通过（$PUSHED 个 ref）。${COLOR_RESET}"
exit 0
